---
import Base from '../layouts/Base.astro';
import { getZones, site } from '../lib/data.js';
import { fmt, niveau, dateFr } from '../lib/farm.js';
const zones = await getZones();
const done = zones.filter((z) => z.measured).sort((a, b) => (b.rapport || 0) - (a.rapport || 0) || b.kpi - a.kpi);
const groups = [...new Set(done.map((z) => z.rapport))].map((n) => ({ n, zones: done.filter((z) => z.rapport === n) }));
const wip = zones.filter((z) => !z.measured);
---
<Base title="Tous les rapports F.A.R.M. — zones de farm Dofus mesurées sur 100 combats | par Doob" description={`Chaque rapport F.A.R.M. : une zone farmée 100 combats en B8 sur ${site.serveur}, drops et prix HDV relevés.`} current="rapports">
  <div class="wrap">
    <div class="page-head">
      <div class="eyebrow"><i></i>Rapports</div>
      <h1>Tous les rapports</h1>
      <p>Un rapport = un épisode YouTube. Chaque zone est farmée 100 combats en B8 sur {site.serveur}, puis les ressources sont estimées au prix de l'HDV. {site.rythme}.</p>
    </div>
    <section style="padding-top:28px">
      <div class="sec-head"><div><h2>Rapport n°4 · Donjons</h2><p class="sub">Sessions de 10 runs en B8 · relevés bruts, hors frais d’entrée</p></div></div>
      <div class="replist">
        <a class="rep donjon-rep" href="/farm/donjons/kardorim/"><span class="no">INC</span><span><b>Crypte de Kardorim</b><small>Incarnam · 10 runs · 400 monstres</small></span><span class="kv"><b>24 min 41 s</b><small>voir la fiche</small></span></a>
        <a class="rep donjon-rep" href="/farm/donjons/tournesol-affame/"><span class="no">AST</span><span><b>Grange du Tournesol Affamé</b><small>Astrub · 10 runs · 400 monstres</small></span><span class="kv"><b>24 min 05 s</b><small>voir la fiche</small></span></a>
        <a class="rep donjon-rep" href="/farm/donjons/chateau-ensable/"><span class="no">AST</span><span><b>Château Ensablé</b><small>Astrub · 10 runs · 400 monstres</small></span><span class="kv"><b>22 min 35 s</b><small>voir la fiche</small></span></a>
      </div>
    </section>
    {groups.map((g) => (
      <section style="padding-top:28px">
        <div class="sec-head"><div><h2>Rapport n°{g.n}</h2><p class="sub">{g.zones.length} zone{g.zones.length > 1 ? 's' : ''} · prix relevés le {dateFr(g.zones[0].date_prix)}</p></div>{g.zones[0].video && <a class="btn btn-ghost" href={g.zones[0].video} target="_blank" rel="noopener">▶ L'épisode</a>}</div>
        <div class="replist">
          {g.zones.map((z) => (
            <a class="rep" href={z.url}>
              <span class="no">{z.region.slice(0, 3).toUpperCase()}</span>
              <span><b>{z.nom}</b><small>{z.region} · niveau {niveau(z.niveau)} · {z.monstres.join(', ')}{(z.anomalie ?? 0) > 0 ? ` · ⚠ ${z.anomalie} % d'anomalie` : ''}{z.monstres_combattus ? ` · ${fmt(z.monstres_combattus)} monstres` : ''}</small></span>
              <span class="kv"><b>{fmt(z.kpi)}</b><small>kamas / combat</small></span>
            </a>
          ))}
        </div>
      </section>
    ))}
    {wip.length > 0 && (
      <section style="padding-top:28px">
        <div class="sec-head"><div><h2>À venir</h2><p class="sub">Ces zones sont dans la cartographie mais n'ont pas encore leur épisode.</p></div></div>
        <div class="mono">{wip.map((z) => <a href={z.url}><span>{z.nom} · {z.region}</span></a>)}</div>
      </section>
    )}
  </div>
</Base>

<style>
.donjon-rep .kv { display: block; white-space: nowrap; }
@media (max-width: 600px) { .donjon-rep .kv b { font-size: 15px; } }
</style>
