---
import Base from '../layouts/Base.astro';
import TeamGrid from '../components/TeamGrid.astro';
import { team, site } from '../lib/data.js';
const pp = team.map((m) => Number(m.prospection) || 0);
const total = pp.reduce((a, b) => a + b, 0);
---
<Base title="Ma team : 8 personnages, une ligne de production de combats — F.A.R.M." description={`Ma team de 8 personnages qui farme chaque zone F.A.R.M. sur ${site.serveur} : classes, rôles et prospection.`} current="team">
  <div class="wrap">
    <div class="page-head">
      <div class="eyebrow"><i></i>Ma team · Serveur {site.serveur}</div>
      <h1>Ma team</h1>
      <p>8 personnages, une seule ligne de production de combats. Toutes les mesures F.A.R.M. sont faites avec cette team, en B8.</p>
    </div>
    <section style="padding-top:28px"><TeamGrid /></section>
    <section style="padding-top:28px">
      <div class="sec-head"><div><h2>Prospection</h2><p class="sub">Les drops mesurés dépendent de la prospection de chaque perso. Le simulateur de chaque fiche part de ces valeurs.</p></div></div>
      <div class="tablewrap">
        <table class="pptable">
          <thead><tr><th>Perso</th><th>Classe</th><th class="num">Prospection</th></tr></thead>
          <tbody>
            {team.map((m) => <tr><td><b>{m.nom}</b></td><td>{m.classe}</td><td class="num">{m.prospection}</td></tr>)}
            <tr class="tot"><td><b>Total team</b></td><td></td><td class="num"><b>{total.toLocaleString('fr-FR')}</b></td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>
