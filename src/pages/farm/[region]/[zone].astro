---
import Base from '../../../layouts/Base.astro';
import { getZones, team, site } from '../../../lib/data.js';
import { slug, fmt, niveau, dateFr, duree, minutes, estimationsOf } from '../../../lib/farm.js';

export async function getStaticPaths() {
  const zones = await getZones();
  return zones.map((z) => ({ params: { region: z.regionSlug, zone: slug(z.nom) }, props: { z, zones } }));
}
const { z, zones } = Astro.props;
const WIP = "WIP : attendre la sortie de l'épisode sur YouTube !";
const regionZones = zones.filter((x) => x.region === z.region && x.measured);
const ppRapport = z.prospection && z.prospection.length ? z.prospection : team.map((m) => Number(m.prospection) || 0);
const total = minutes(z.sessions);
const preciseDuration = (min) => {
  const seconds = Math.round(min * 60);
  return `${Math.floor(seconds / 60)} min ${String(seconds % 60).padStart(2, '0')} s`;
};
const cph = total ? z.combats / (total / 60) : 0;
const data = {
  cur: z.nom,
  team: team.map((m, i) => [m.nom, ppRapport[i] ?? 0]),
  zone: { res: z.drops.map((d) => ({ n: d.ressource, mobs: d.monstres, b: d.taux_base, d: d.quantite, p: d.prix_manquant ? null : d.prix, v: d.ventes_30j ?? null, ek: d.eklame ? 1 : 0 })), combats: z.combats, kc: z.kamas_combats || 0, est: estimationsOf(z), cph },
  region: regionZones.map((x) => ({ z: x.nom, u: x.url, combats: x.combats, kc: x.kamas_combats || 0, est: estimationsOf(x), pp: x.prospection && x.prospection.length ? x.prospection : team.map((m) => Number(m.prospection) || 0), res: x.drops.map((d) => ({ b: d.taux_base, d: d.quantite, p: d.prix, ek: d.eklame ? 1 : 0 })) })),
};
const title = z.measured
  ? `Farm à ${z.nom} : rentabilité mesurée sur 100 combats (K.P.I.) — F.A.R.M.`
  : `Farm à ${z.nom} (${z.region}) : rapport F.A.R.M. à venir`;
const description = z.measured
  ? `${z.nom} (${z.region}, niveau ${niveau(z.niveau)}) : ${fmt(z.kpi)} kamas par combat, mesurés sur ${z.combats} combats en B8 sur ${site.serveur}. Drops, taux, prix HDV et simulateur de prospection.`
  : `${z.nom} (${z.region}) : le rapport F.A.R.M. arrive bientôt sur YouTube. Monstres : ${z.monstres.join(', ')}.`;
---
<Base title={title} description={description} current="rapports">
  <div class="wrap">
    <nav class="crumb" aria-label="Fil d'Ariane"><a href="/#atlas">Cartographie</a><span>›</span><a href={`/farm/${z.regionSlug}/`}>{z.region}</a><span>›</span>{z.nom}</nav>
    <div class="zhead">
      <div>
        <div class="eyebrow"><i></i>{z.measured ? `Rapport n°${z.rapport} · ${z.region}` : `${z.region} · à venir`}</div>
        <h1>{z.nom}</h1>
        <p class="meta">Niveau {niveau(z.niveau)} · {z.monstres.join(', ')}{z.measured && ` · mesuré en B8 sur ${site.serveur}`}</p>
      </div>
      {z.measured && (
        <div class="kbig">
          <small>K.P.I. mesuré — Kamas Par Itération</small>
          <div><b>{fmt(z.kpi)}</b><span class="u">kamas / combat</span></div>
          <div class="act">
            <a class="btn btn-ghost" href={z.video || site.youtube} target="_blank" rel="noopener">▶ Voir l'épisode</a>
            {z.mosaique && <a class="btn btn-ghost" href="#mosaique">Mosaïque</a>}
          </div>
        </div>
      )}
    </div>
    {z.measured && (
      <div class="facts">
        <div class="fact"><small>Combats</small><b>{z.combats} / 100</b></div>
        <div class="fact"><small>Sessions</small><b>{z.sessions.length}</b><em>{z.sessions.map(preciseDuration).join(' · ')}</em></div>
        <div class="fact"><small>Temps total</small><b>{preciseDuration(total)}</b><em>{cph.toFixed(1).replace('.', ',')} combats / h</em></div>
        <div class="fact"><small>Kamas / heure</small><b>{fmt(z.kph)}</b></div>
        <div class="fact"><small>Valeur totale du butin</small><b>{fmt(z.kpi * z.combats)}</b><em>{z.kamas_combats_inconnus ? 'drops + valorisations (kamas de combat non relevés)' : 'drops + kamas de combat + valorisations'}</em></div>
        <div class="fact"><small>% d'anomalie</small><b>{z.anomalie ?? '—'} %</b></div>
        {z.monstres_combattus != null && (
          <div class="fact"><small>Monstres combattus</small><b>{fmt(z.monstres_combattus)}</b><em>{(z.monstres_combattus / z.combats).toFixed(1).replace('.', ',')} / combat</em></div>
        )}
        <div class="fact"><small>Prix HDV {site.serveur} du</small><b>{dateFr(z.date_prix)}</b><em>ventes 30 j utilisées</em></div>
      </div>
    )}
  </div>

  {!z.measured ? (
    <section>
      <div class="wrap">
        <div class="wipbox">{WIP}</div>
        <div class="mono">{z.monstres.map((m) => <span>{m}</span>)}</div>
        <p class="sub" style="margin-top:24px"><a href="/#classement" style="color:var(--violet)">← Voir les zones déjà mesurées</a></p>
      </div>
    </section>
  ) : (
    <>
      {(z.estimations.length > 0 || z.notes) && (
        <section style="padding-top:8px">
          <div class="wrap">
            <div class="sec-head"><div><h2>Valorisation complémentaire</h2><p class="sub">Montants estimés inclus dans le K.P.I., distincts des prix unitaires des ressources.</p></div></div>
            {z.estimations.map((e) => <div class="panel" style="padding:20px"><b>{e.libelle} : {fmt(e.valeur)} kamas estimés</b><p class="sub">{e.quantite != null ? `${fmt(e.quantite)} objets droppés sur la session · ` : 'Nombre d’objets non renseigné · '}valorisation globale, sans détail par équipement.</p></div>)}
            {z.notes && <p class="sub" style="margin-top:16px">{z.notes}</p>}
            {z.estimations.length > 0 && <p class="sub">Simulation : ce forfait est ajusté au nombre de personnages (B/8), sans correction de prospection faute de détail par équipement. Les Éklâmes ne sont pas influencées par la prospection.</p>}
          </div>
        </section>
      )}
      <section id="sim">
        <div class="wrap">
          <div class="sec-head"><div><h2>Simule avec ta team</h2><p class="sub">Change la taille de la team (B1 à B8) et la prospection : le taux de drop, le K.P.I. et le classement se mettent à jour.</p></div></div>
          <div class="sim">
            <div class="ctrl">
              <div><span class="lbl">Taille de la team</span>
                <div class="seg wrapit" id="nSeg" role="group" aria-label="Nombre de comptes">
                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <button type="button" data-v={n}>B{n}</button>)}
                </div></div>
              <div><span class="lbl">Prospection par personnage</span>
                <div class="seg wrapit" id="mSeg" role="group" aria-label="Prospection">
                  <button type="button" data-v="doob">Team Doob</button><button type="button" data-v="100">100 PP</button><button type="button" data-v="200">200 PP</button><button type="button" data-v="300">300 PP</button><button type="button" data-v="perso">Ma team</button>
                </div></div>
              <div><span class="lbl" id="ppTitle">Prospection de chaque personnage</span><div class="pps" id="pps"></div>
                <p class="saved" id="saved" style="margin-top:8px"></p></div>
            </div>
            <div class="out" aria-live="polite">
              <div><small class="lbl" style="margin:0" id="outLbl">K.P.I. projeté</small>
                <div class="big"><span id="kProj"></span><small>kamas / combat</small></div>
                <span class="delta" id="kDelta"></span></div>
              <div class="okv">
                <div><small>Kamas / heure</small><b id="hProj"></b></div>
                <div><small>Multiplicateur moyen</small><b id="mAvg"></b></div>
                <div><small>Drops / 100 combats</small><b id="dProj"></b></div>
                <div><small>Rang à {z.region}</small><b id="rProj"></b></div>
              </div>
              <p class="hint" id="insight"></p>
            </div>
          </div>
        </div>
      </section>

      <section style="padding-top:8px">
        <div class="wrap">
          <div class="sec-head"><div><h2>Les drops</h2><p class="sub">Taux de base : DofusDB. Quantités : mesurées sur {z.combats} combats, puis recalculées pour ta team. L'Éklâme (drop global, tous monstres) est affichée à titre indicatif : taux réel variable de 1 à 4 %.</p></div></div>
          <div class="panel"><div class="tbl-wrap"><table class="dt">
            <thead><tr><th>Ressource</th><th class="num hm">Taux<br>de base</th><th class="num">Taux avec<br>ta team</th><th class="num hm">PP pour<br>100 %</th><th class="num">Drops<br>/ 100 combats</th><th class="num hm">Prix<br>HDV {site.serveur}</th><th class="num">Valeur<br>du lot</th><th class="num hm">Ventes<br>30 j</th><th class="num">Kamas<br>/ combat</th></tr></thead>
            <tbody id="drops"></tbody></table></div>
            <div class="count" id="dCount"></div></div>
        </div>
      </section>

      <section style="padding-top:8px">
        <div class="wrap two">
          <div>
            <div class="sec-head"><div><h2>{z.region} avec ta team</h2><p class="sub">Le classement de la région, recalculé avec tes réglages.</p></div></div>
            <div class="panel"><table class="rt"><thead><tr><th>#</th><th>Zone</th><th class="num">K.P.I.</th><th class="num">Vs mesure</th></tr></thead><tbody id="rank"></tbody></table></div>
          </div>
          <div>
            <div class="sec-head"><div><h2>Méthode</h2><p class="sub">Comment on recalcule.</p></div></div>
            <div class="methodo">
              <p>Chaque personnage tire ses drops séparément. Son taux = taux de base × un multiplicateur lié à sa prospection, plafonné à 100 %.</p>
              <code>m(PP) = 0,74 + 1,755 / (1 + e^((150 − PP) / 85))<br>minimum 1× · maximum ≈ 2,5×</code>
              <p>Les drops projetés partent des drops réellement comptés, ajustés par le rapport entre ta team et la team Doob.</p>
              <ul><li>Formule communautaire, à valider avec nos mesures.</li><li>Hors challenges, étoiles et bonus de zone.</li><li>Temps de combat identique quel que soit la taille de la team.</li><li>Prix HDV {site.serveur} datés : ils bougent.</li></ul>
            </div>
          </div>
        </div>
      </section>

      {z.mosaique && (
        <section id="mosaique" style="padding-top:8px">
          <div class="wrap">
            <div class="sec-head"><div><h2>La mosaïque des {z.combats} combats</h2></div></div>
            <img class="mosaic-img" src={z.mosaique} alt={`Mosaïque des ${z.combats} combats à ${z.nom}`} loading="lazy">
          </div>
        </section>
      )}
      <script type="application/json" id="fiche-data" set:html={JSON.stringify(data)}></script>
    </>
  )}
</Base>

<script>
  import { mult, fmt, ppFor100 } from '../../../lib/farm.js';
  const el = document.getElementById('fiche-data');
  if (el) {
    const FD = JSON.parse(el.textContent);
    const $ = (id) => document.getElementById(id);
    const pct = (x) => (x >= 10 ? Math.round(x) : x >= 1 ? x.toFixed(1) : x.toFixed(2)).toString().replace('.', ',') + ' %';
    const x2 = (m) => '× ' + m.toFixed(2).replace('.', ',');
    const TEAM = FD.team, ACT = TEAM.map((t) => t[1]);
    const KEY = 'farm-ma-team';
    let st = { n: 8, mode: 'doob', perso: [200, 200, 200, 200, 200, 200, 200, 200] };
    try { const s = JSON.parse(localStorage.getItem(KEY)); if (s && s.perso) st = { ...st, ...s }; } catch (e) {}
    const teamPP = () => st.mode === 'doob' ? ACT.slice(0, st.n) : st.mode === 'perso' ? st.perso.slice(0, st.n) : Array(st.n).fill(+st.mode);
    const E = (b, pps) => pps.reduce((a, pp) => a + Math.min(1, (b / 100) * mult(pp)), 0);
    const proj = (res, pps, act) => res.map((r) => { const ea = E(r.b, act); return { ...r, dp: r.ek ? r.d * pps.length / act.length : ea ? r.d * E(r.b, pps) / ea : 0 }; });
    const kpi = (rs, combats, kc, f, est = 0) => (rs.reduce((a, r) => a + r.dp * (r.p || 0), 0) + (kc + est) * f) / combats;
    const Z = FD.zone;
    const kMeas = kpi(proj(Z.res, ACT, ACT), Z.combats, Z.kc, 1, Z.est);
    const seg = (id, val) => document.querySelectorAll('#' + id + ' button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.v == String(val) ? 'true' : 'false'));
    function save() {
      if (st.mode === 'perso') { localStorage.setItem(KEY, JSON.stringify(st)); $('saved').textContent = 'Enregistré dans ton navigateur : tu retrouveras ta team à ta prochaine visite.'; }
      else $('saved').textContent = st.mode === 'doob' ? 'Prospection réelle relevée pour ce rapport.' : 'Choisis « Ma team » pour saisir la prospection de chacun de tes persos.';
    }
    function renderInputs() {
      const pps = teamPP();
      const names = st.mode === 'doob' ? TEAM.slice(0, st.n).map((t) => t[0]) : Array.from({ length: st.n }, (_, i) => 'Perso ' + (i + 1));
      const editable = st.mode === 'perso';
      $('pps').innerHTML = pps.map((pp, i) => `<div class="pp"><label for="pp${i}">${names[i]}</label><input id="pp${i}" type="number" inputmode="numeric" min="0" max="2000" step="10" value="${pp}" ${editable ? '' : 'disabled'} data-i="${i}"><span class="mx">${x2(mult(pp))}</span></div>`).join('');
      $('pps').querySelectorAll('input').forEach((inp) => inp.addEventListener('input', (e) => {
        const v = Math.max(0, Math.min(2000, +e.target.value || 0)); st.perso[+e.target.dataset.i] = v;
        e.target.nextElementSibling.textContent = x2(mult(v)); save(); renderOut();
      }));
      $('ppTitle').textContent = editable ? 'Prospection de chaque personnage (modifiable)' : st.mode === 'doob' ? 'Prospection réelle de la team Doob' : 'Prospection de chaque personnage';
    }
    function renderOut() {
      const pps = teamPP(), f = st.n / 8;
      const rs = proj(Z.res, pps, ACT), k = kpi(rs, Z.combats, Z.kc, f, Z.est), dl = (k / kMeas - 1) * 100;
      const same = st.mode === 'doob' && st.n === 8;
      $('kProj').textContent = fmt(k);
      $('kDelta').className = 'delta ' + (same || Math.abs(dl) < 0.5 ? 'eq' : dl > 0 ? 'up' : 'down');
      $('kDelta').textContent = same ? '= mesure réelle' : (dl > 0 ? '+' : '') + dl.toFixed(0).replace('-', '−') + ' % vs mesure B8';
      $('outLbl').textContent = same ? 'K.P.I. mesuré (team Doob, B8)' : 'K.P.I. projeté — B' + st.n;
      $('hProj').textContent = fmt(k * Z.cph);
      $('mAvg').textContent = x2(pps.reduce((a, p) => a + mult(p), 0) / pps.length);
      $('dProj').textContent = fmt(rs.reduce((a, r) => a + r.dp, 0));
      const all = FD.region.map((x) => ({ z: x.z, u: x.u, k: kpi(proj(x.res, pps, x.pp), x.combats, x.kc, f, x.est), km: kpi(proj(x.res, x.pp, x.pp), x.combats, x.kc, 1, x.est) }));
      const measRank = [...all].sort((a, b) => b.km - a.km).map((x) => x.z);
      const ranked = [...all].sort((a, b) => b.k - a.k);
      $('rank').innerHTML = ranked.map((x, i) => { const mv = measRank.indexOf(x.z) - i; return `<tr class="${x.z === FD.cur ? 'me' : ''}"><td class="r">${i + 1}</td><td class="zn"><a href="${x.u}"><b>${x.z}</b></a></td><td class="num"><b>${fmt(x.k)}</b></td><td class="num"><span class="arrow ${mv > 0 ? 'up' : mv < 0 ? 'down' : 'eq'}">${mv > 0 ? '▲ ' + mv : mv < 0 ? '▼ ' + -mv : '='}</span></td></tr>`; }).join('');
      $('rProj').textContent = ranked.findIndex((x) => x.z === FD.cur) + 1 + 'e / ' + ranked.length;
      $('drops').innerHTML = [...rs.filter((r) => r.d > 0), ...rs.filter((r) => !(r.d > 0))].map((r) => {
        const rates = pps.map((pp) => r.ek ? r.b : Math.min(100, r.b * mult(pp))); const mn = Math.min(...rates), mx = Math.max(...rates); const need = r.ek ? null : ppFor100(r.b);
        if (!(r.d > 0)) return `<tr class="nodrop"><td class="rn"><b>${r.n}</b><small>${r.mobs || ''}</small></td><td class="num hm">${r.ek ? '1–4 %' : pct(r.b)}</td><td class="num">${r.ek ? '1–4 % (hors PP)' : mn === mx ? pct(mn) : pct(mn) + ' – ' + pct(mx)}</td><td class="num hm">${r.ek ? '—' : need === null ? 'jamais' : need === 0 ? '0' : fmt(Math.ceil(need / 10) * 10)}</td><td class="num">${r.ek ? 'pas encore mesurée' : 'aucun drop'}</td><td class="num hm">—</td><td class="num">—</td><td class="num hm">—</td><td class="num">—</td></tr>`;
        return `<tr><td class="rn"><b>${r.n}</b><small>${r.mobs || ''}</small></td><td class="num hm">${r.ek ? '1–4 %' : pct(r.b)}</td><td class="num">${r.ek ? '1–4 % (hors PP)' : mn === mx ? pct(mn) : pct(mn) + ' – ' + pct(mx)}${mn >= 100 ? '<span class="cap100">MAX</span>' : ''}</td><td class="num hm">${r.ek ? '—' : need === null ? '<span style="color:var(--muted)">jamais</span>' : need === 0 ? '0' : fmt(Math.ceil(need / 10) * 10)}</td><td class="num">${fmt(r.dp)}${same ? '' : `<span class="proj">mesuré : ${fmt(r.d)}</span>`}</td><td class="num hm">${r.p == null ? 'non renseigné' : fmt(r.p)}</td><td class="num"><b>${r.p == null ? '—' : fmt(r.dp * r.p)}</b>${same || r.p == null ? '' : `<span class="proj">mesuré : ${fmt(r.d * r.p)}</span>`}</td><td class="num hm">${r.v == null ? '—' : fmt(r.v)}</td><td class="num"><b>${r.p == null ? 'non valorisé' : fmt((r.dp * r.p) / Z.combats)}</b></td></tr>`;
      }).join('');
      const noMes = rs.filter((r) => !(r.d > 0) && !r.ek).length;
      $('dCount').textContent = `${rs.length} ressources${noMes ? ` (dont ${noMes} sans drop pendant la mesure)` : ''}${rs.some((r) => r.ek && !r.d) ? ' · Éklâme affichée à titre indicatif (non mesurée)' : rs.some((r) => r.ek) ? ' · Éklâme mesurée, indépendante de la PP' : ''} · « PP pour 100 % » = prospection à partir de laquelle chaque perso drop la ressource à tous les coups`;
      const caps = Z.res.map((r) => ppFor100(r.b)).filter((v) => v !== null && v > 0);
      const saturating = Z.res.filter((r) => ppFor100(r.b) !== null && ppFor100(r.b) > 0).length;
      $('insight').innerHTML = saturating ? `Ici, ${saturating} ressource${saturating > 1 ? 's' : ''} sur ${Z.res.length} peu${saturating > 1 ? 'vent' : 't'} tomber à tous les coups : à partir d'environ <b>${fmt(Math.ceil(Math.min(...caps) / 10) * 10)}–${fmt(Math.ceil(Math.max(...caps) / 10) * 10)} PP</b> par perso. Au-delà, la prospection ne rapporte plus que sur les ressources plus rares.` : 'Aucune ressource ne plafonne ici : chaque point de prospection compte.';
    }
    document.querySelectorAll('#nSeg button').forEach((b) => b.addEventListener('click', () => { st.n = +b.dataset.v; seg('nSeg', st.n); renderInputs(); save(); renderOut(); }));
    document.querySelectorAll('#mSeg button').forEach((b) => b.addEventListener('click', () => { st.mode = b.dataset.v; seg('mSeg', st.mode); renderInputs(); save(); renderOut(); }));
    seg('nSeg', st.n); seg('mSeg', st.mode); renderInputs(); save(); renderOut();
  }
</script>
