---
import { site } from '../lib/data.js';
const { current } = Astro.props;
const links = [
  ['classement', 'Classement', '/#classement'],
  ['atlas', 'Cartographie', '/#atlas'],
  ['elevage', 'Élevage', '/elevage/'],
  ['rapports', 'Rapports', '/rapports/'],
  ['team', 'Ma team', '/team/'],
  ['contact', 'Contact', '/contact/'],
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="F.A.R.M. — accueil">
      <img src="/images/logo.png" alt="Logo Doob" width="68" height="34">
      <span class="sep"></span>
      <b>F.A.R.M.</b>
    </a>
    <span class="srv" style="margin-right:auto">Serveur {site.serveur}</span>
    <nav class="links" aria-label="Navigation principale">
      {links.map(([k, label, href]) => <a href={href} aria-current={current === k ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="btn btn-primary" href={site.youtube} target="_blank" rel="noopener">▶ La chaîne</a>
  </div>
  <nav class="mnav" aria-label="Navigation mobile">
    {links.map(([k, label, href]) => <a href={href} aria-current={current === k ? 'page' : undefined}>{label}</a>)}
  </nav>
</header>

<style>
  .nav { gap: 12px; }
  .links a { padding: 10px 9px; white-space: nowrap; }
  .nav .btn { white-space: nowrap; }
  @media (max-width: 1100px) {
    .links { display: none; }
    .mnav { display: flex; gap: 4px; overflow-x: auto; padding: 0 16px 10px; scrollbar-width: none; }
    .mnav::-webkit-scrollbar { display: none; }
    .mnav a { flex: none; padding: 8px 12px; border-radius: 8px; color: var(--muted); font-size: 14px; border: 1px solid var(--border); }
    .mnav a[aria-current="page"] { color: var(--text); background: var(--raised); border-color: var(--violet); }
  }
</style>
