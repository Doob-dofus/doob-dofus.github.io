---
import { team } from '../lib/data.js';
const groups = [['direction', 'La direction'], ['stagiaires', 'Les stagiaires — Objectif CDI']];
---
<div class="org">
  {groups.map(([g, label]) => (
    <div>
      <h3>{label}</h3>
      <div class="team">
        {team.filter((m) => m.groupe === g).map((m) => (
          <div class="member">
            <a class="pic" href={m.lien} target="_blank" rel="noopener" title={`Voir le stuff de ${m.nom} sur Dofusbook`}><img src={m.sprite} alt={`${m.nom}, ${m.classe}`} loading="lazy" width="62" height="92"></a>
            <div><b>{m.nom}</b><a class="cls" href={m.lien} target="_blank" rel="noopener" title={`Voir le stuff de ${m.nom} sur Dofusbook`}>{m.classe}</a><div class="role">{m.niveau}</div></div>
          </div>
        ))}
      </div>
    </div>
  ))}
  <p class="dbk-note">🎒 Liens Dofusbook : clique sur l'image ou la classe d'un perso pour voir son stuff.</p>
</div>
